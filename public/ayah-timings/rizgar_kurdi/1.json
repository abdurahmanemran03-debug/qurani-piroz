ayah": 1,
    "start": 0.0,
    "end": 5.58,
    "text": "بسم الله الرحمن الرحيم"
  },
  {
    "ayah": 2,
    "start": 5.58,
    "end": 10.94,
    "text": "الحمد لله رب العالمين"
  },
  {
    "ayah": 3,
    "start": 10.94,
    "end": 14.22,
    "text": "الرحمن الرحيم"
  },
  {
    "ayah": 4,
    "start": 14.22,
    "end": 17.66,
    "text": "مالك يوم الدين"
  },
  {
    "ayah": 5,
    "start": 17.66,
    "end": 22.74,
    "text": "إياك نعبد وإياك نستعين"
  },
  {
    "ayah": 6,
    "start": 22.74,
    "end": 26.76,
    "text": "إهدنا الصراط المستقيم"
  },
  {
    "ayah": 7,
    "start": 26.76,
    "end": 31.22,
    "text": "صراط الذين أنعمت عليهم"
  },
  {
    "ayah": 8,
    "start": 31.22,
    "end": 34.42,
    "text": "غير المغطوب عليهم"
  },
  {
    "ayah": 9,
    "start": 34.42,
    "end": 40.32,
    "text": "ولا الضالين"
  }
